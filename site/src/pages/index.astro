---
import Base from "../layouts/Base.astro";
import InstallBox from "../components/InstallBox.astro";
import ThemeToggle from "../components/ThemeToggle.astro";
import { getPlugins, getMarketplaceMeta } from "../data/plugins";

const plugins = getPlugins();
const meta = getMarketplaceMeta();
const baseRaw = import.meta.env.BASE_URL;
const base = baseRaw.endsWith("/") ? baseRaw : baseRaw + "/";
---

<Base title="HP-00 / Plugins">
  <main class="page">
    <div class="col">
      <header class="intro">
        <p class="intro__name">HP-00 / Plugins</p>
      </header>

      <section class="section">
        <p class="label">Install in Claude Code:</p>
        <div class="install-stack">
          <InstallBox command={meta.installCommand} />
          <InstallBox command="/plugin install <plugin>@hp-00-plugins" />
        </div>
      </section>

      <section class="section">
        <p class="label">Plugins</p>
        <div class="plugin-list">
          {plugins.map((p) => (
            <article class="entry">
              <h2 class="entry__title">
                <a href={`${base}${p.slug}`}>
                  {p.name}
                  <span class="link__arrow" aria-hidden="true">→</span>
                </a>
              </h2>
              <p class="entry__category">[{p.category}]</p>
              <p class="entry__date">{p.updated ? `[${p.updated}]` : ""}</p>
            </article>
          ))}
        </div>
      </section>

      <footer class="foot">
        <ThemeToggle />
        <a
          href={meta.githubUrl}
          rel="noopener"
          target="_blank"
          class="link"
        >github</a>
      </footer>
    </div>
  </main>
</Base>

<style>
  .page {
    padding: 4rem 0 2.5rem;
  }
  @media (max-width: 640px) {
    .page {
      padding: 2.5rem 0 2rem;
    }
  }
  .intro__name {
    margin: 0;
    color: var(--color-text);
    font-size: 0.8125rem;
    font-weight: 500;
  }
  .install-stack {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }
  .foot {
    margin-top: 3.5rem;
    padding-top: 1rem;
    border-top: 1px solid var(--color-border);
    color: var(--color-dim);
    font-size: 0.6875rem;
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 1rem;
  }
  .foot .link {
    color: var(--color-muted);
  }
  .foot .link:hover {
    color: var(--color-text);
  }
</style>
